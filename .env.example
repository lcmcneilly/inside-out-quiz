# Set these in Vercel > Settings > Environment Variables for Production,
# Preview and Development. Never commit real values.

# Required. The Inbound Webhook URL from the Ivorey workflow.
IVOREY_WEBHOOK_URL=

# Optional. Any URL that accepts a POST, used only if Ivorey will not take a
# lead. Leave blank if you do not have one.
BACKUP_WEBHOOK_URL=
